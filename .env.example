# ==============================================================================
# ScamShield Environment Configuration
# ==============================================================================
# Copy this file to `server/.env` (or `.env` in root) and fill in your values.
# DO NOT commit real secrets or production credentials to version control.

# Server Port (default: 3001)
PORT=3001

# Environment Mode ("development" | "production" | "test")
NODE_ENV=development

# Database Connection (SQLite file connection string for Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Allowed Frontend Client Origin for CORS (e.g. http://localhost:5173 in development)
CLIENT_URL=http://localhost:5173

# Optional legacy alias for CLIENT_URL
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# External Threat Intelligence APIs (Optional)
# If omitted or left as placeholder, ScamShield automatically operates
# with its high-accuracy deterministic heuristic & regex engines.
# ------------------------------------------------------------------------------

# Google Gemini API Key (for structured threat explanations)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Safe Browsing Lookup API v4 Key (for global malicious URL verification)
# Get a key at: https://console.cloud.google.com/apis/credentials
SAFEBROWSING_API_KEY=your_google_safe_browsing_api_key_here
